{
  "name": "last-epoch-optimal-crafting-route-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "model": "python -X utf8 scripts/build_runtime_model.py --verify-only",
    "dev": "vite --host 127.0.0.1",
